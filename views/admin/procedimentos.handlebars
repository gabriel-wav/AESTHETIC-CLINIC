<div class="card">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h2>Catálogo de Procedimentos</h2>
        <button class="btn btn-primary" onclick="abrirModalNovo()">+ Novo Procedimento</button>
    </div>

    <table class="tabela-dados">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Tempo</th>
                <th>Preço</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            {{#each procedimentos}}
            <tr>
                <td>{{this.id}}</td>
                <td>{{this.nome}}</td>
                <td>{{this.duracao_minutos}}m</td>
                <td>R$ {{this.preco}}</td>
                <td>
                    <button class="btn btn-secondary" onclick="abrirModalEditar('{{this.id}}', '{{this.nome}}', '{{this.descricao}}', '{{this.duracao_minutos}}', '{{this.preco}}')">Editar</button>
                    <form action="/admin/procedimentos/excluir/{{this.id}}" method="POST" style="display:inline;" onsubmit="return confirm('Deseja excluir?');">
                        <button type="submit" class="btn btn-danger">Excluir</button>
                    </form>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>

<div id="modal-procedimento" class="modal">
    <div class="modal-content">
        <span class="close-modal" onclick="fecharModal()">&times;</span>
        <h3 id="modal-titulo">Procedimento</h3>
        <form action="/admin/procedimentos/salvar" method="POST">
            <input type="hidden" id="procedimento-id" name="id">
            <div class="form-group">
                <label>Nome</label>
                <input type="text" id="nome" name="nome" required>
            </div>
            <div class="form-group">
                <label>Descrição</label>
                <textarea id="descricao" name="descricao" rows="2" required></textarea>
            </div>
            <div style="display: flex; gap: 10px;">
                <div class="form-group" style="flex: 1;">
                    <label>Duração (minutos)</label>
                    <input type="number" id="duracao_minutos" name="duracao_minutos" required>
                </div>
                <div class="form-group" style="flex: 1;">
                    <label>Preço (R$)</label>
                    <input type="number" step="0.01" id="preco" name="preco" required>
                </div>
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%;">Salvar</button>
        </form>
    </div>
</div>