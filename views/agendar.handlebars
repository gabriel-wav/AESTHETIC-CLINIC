<div class="card">
    <div class="img-agendar-wrapper">
        <img src="/img/bannerRevitalize.svg" alt="Clínica Estética Revitalize">
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h2 style="color: var(--cor-primaria); margin: 0;">Realizar Agendamento</h2>
        <a href="/cliente/perfil" class="btn btn-secondary" style="font-size: 0.85rem; padding: 0.4rem 0.9rem;">✏️ Editar Perfil</a>
    </div>

    <div class="cliente-info-bar">
        <span>👤 <strong>{{cliente.nome_completo}}</strong></span>
        <span>📱 {{cliente.telefone}}</span>
        <span>✉️ {{cliente.email}}</span>
    </div>

    <form action="/agendar" method="POST">
        <div class="form-group">
            <label for="procedimento_id">Procedimento Desejado</label>
            <select id="procedimento_id" name="procedimento_id" required>
                <option value="" disabled selected>Selecione...</option>
                {{#each procedimentos}}
                    <option value="{{this.id}}">{{this.nome}} — R$ {{this.preco}} ({{this.duracao_minutos}}min)</option>
                {{/each}}
            </select>
        </div>
        <div class="form-group">
            <label for="data_hora">Data e Horário</label>
            <input type="datetime-local" id="data_hora" name="data_hora" required>
        </div>
        <button type="submit" class="btn btn-primary">Confirmar Agendamento</button>
    </form>
</div>
