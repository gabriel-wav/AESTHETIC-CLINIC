<div class="card" style="max-width: 560px; margin: 0 auto;">
    <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.75rem;">
        <a href="/agendar" style="color: var(--cor-primaria); text-decoration: none; font-size: 1.3rem;">←</a>
        <h2 style="color: var(--cor-primaria); margin: 0;">Meu Perfil</h2>
    </div>

    <form action="/cliente/perfil" method="POST">
        <div class="form-group">
            <label for="nome_completo">Nome Completo</label>
            <input type="text" id="nome_completo" name="nome_completo" value="{{cliente.nome_completo}}" required>
        </div>
        <div class="form-group">
            <label for="email">E-mail</label>
            <input type="email" id="email" name="email" value="{{cliente.email}}" required>
        </div>
        <div class="form-group">
            <label for="telefone">Telefone / WhatsApp</label>
            <input type="text" id="telefone" name="telefone" value="{{cliente.telefone}}" required>
        </div>
        <div style="display: flex; gap: 1rem;">
            <div class="form-group" style="flex: 1;">
                <label for="username">Usuário</label>
                <input type="text" id="username" name="username" value="{{cliente.username}}" required>
            </div>
            <div class="form-group" style="flex: 1;">
                <label for="nova_senha">Nova Senha <span style="font-weight: 400; color: #999;">(deixe vazio para manter)</span></label>
                <input type="password" id="nova_senha" name="nova_senha" placeholder="Nova senha" minlength="4">
            </div>
        </div>
        <button type="submit" class="btn btn-primary" style="width: 100%;">Salvar Alterações</button>
    </form>
</div>
